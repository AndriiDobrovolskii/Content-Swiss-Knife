# Provider, model and thinking level are now chosen at runtime in the app's
# "AI Model Settings" menu (the sliders icon in the sidebar header) and sent with every
# request. The values below are only the FALLBACK used when a request arrives without
# settings — a curl call, or a browser running an older bundle.
#
# The list of selectable models lives in src/prompt-core/model-catalog.json, which the
# frontend and the server both read. Add a model there, not here.

# Fallback LLM Provider: "openai" | "anthropic" | "gemini"
# ("openai" is reachable only this way — it is deliberately not offered in the settings menu.)
LLM_PROVIDER=anthropic

# OpenAI (fallback)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Fallback slot models, used only when a request carries no settings.
ANTHROPIC_MODEL_THINKING=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Fallback thinking level for the Deep slot: disabled | low | medium | high
ANTHROPIC_THINKING_EFFORT=medium

# Google Gemini — Gemini 3.1 Pro (deep) and Gemini 3.6 Flash (fast).
# Thinking levels: Flash accepts minimal/low/medium/high; Pro accepts low/medium/high only
# (it cannot disable thinking at all).
GEMINI_API_KEY=AIza...

# Serper.dev — web retrieval (Phase 2)
SERPER_API_KEY=...

# Jina Reader — optional fallback for JS-heavy / blocked pages.
# Leave blank to use the free no-key tier (rate-limited). A key raises the limit.
JINA_API_KEY=

# Server port (default 3001)
PORT=3001
