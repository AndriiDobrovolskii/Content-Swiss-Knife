# Provider, model and thinking level are chosen at runtime in the app's "AI Model Settings"
# menu (the sliders icon in the sidebar header) and sent with every request — PER SLOT, so
# Deep on Anthropic and Fast on Gemini in the same run is a supported configuration. The
# shipped default is exactly that: Sonnet 5 on Deep, Gemini 3.7 Flash on Fast, which means a
# working setup normally needs BOTH ANTHROPIC_API_KEY and GEMINI_API_KEY.
#
# Everything below is only the FALLBACK used when a request arrives without settings — a curl
# call, or a browser running an older bundle. It is not what serves your generations. The
# startup log prints which providers actually loaded; the [LLM] lines print what served each
# call.
#
# The list of selectable models lives in src/prompt-core/model-catalog.json, which the
# frontend and the server both read. Add a model there, not here.

# Fallback LLM Provider: "openai" | "anthropic" | "gemini"
# ("openai" is reachable only this way — it is deliberately not offered in the settings menu.)
LLM_PROVIDER=anthropic

# OpenAI (fallback)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Fallback slot models, used only when a request carries no settings.
ANTHROPIC_MODEL_THINKING=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Fallback thinking level for the Deep slot: disabled | low | medium | high
ANTHROPIC_THINKING_EFFORT=medium

# Google Gemini — Gemini 3.1 Pro (deep) and Gemini 3.7 Flash (fast; 3.6 Flash is still
# selectable in the settings menu, just no longer the default).
# Thinking levels: Flash accepts minimal/low/medium/high; Pro accepts low/medium/high only
# (it cannot disable thinking at all).
# NOT optional in the default setup: the Fast slot ships on Gemini 3.7 Flash, so without this
# key every translation and PDF extraction fails.
GEMINI_API_KEY=AIza...

# Serper.dev — web retrieval (Phase 2)
SERPER_API_KEY=...

# Jina Reader — optional fallback for JS-heavy / blocked pages.
# Leave blank to use the free no-key tier (rate-limited). A key raises the limit.
JINA_API_KEY=

# Server port (default 3001)
PORT=3001
