# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment secrets — never commit
.env
.env.local
.env.*.local

# Local knowledge/plan files — not part of the codebase.
# "Knowlege/" is the original typo, kept so any stale local folder stays ignored.
#
# Leading slash is load-bearing: an unanchored `Knowledge/` matches at ANY depth, and git
# is case-insensitive on Windows by default — so it silently swallowed `docs/knowledge/`,
# the harness's own delivery-summary directory. Anchor both to the repo root.
/Knowlege/
/Knowledge/

# Local usage/cost tracking database — machine-specific, not part of the codebase
data/*.db
data/*.db-*

# Angular build cache
.angular/

# Node fatal-error diagnostic reports (see .npmrc) — machine-specific crash forensics
.diagnostics/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env.example
*.example

# Generated coverage report — reproducible from `npm run test:coverage`
coverage/
